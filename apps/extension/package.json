{
  "name": "@fazetime/extension",
  "version": "0.2.0",
  "private": true,
  "description": "FaZeTime Chrome MV3 extension (P1: bundled panel with local MOCK/FIXTURE data only).",
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "copy:documents": "node scripts/copy-to-documents.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build:mock": "wxt build",
    "build:live": "WXT_FAZETIME_MODE=live wxt build",
    "build:live:pi": "WXT_FAZETIME_MODE=live WXT_FAZETIME_API_BASE=http://fazetime:8000 wxt build",
    "copy:live": "node scripts/copy-to-documents.mjs chrome-mv3-live fazetime-extension-live",
    "copy:live:pi": "node scripts/copy-to-documents.mjs chrome-mv3-live-fazetime fazetime-extension-live-pi",
    "e2e:live": "node scripts/e2e-live.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "happy-dom": "20.14.6",
    "playwright": "1.65.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "wxt": "0.21.5"
  }
}
