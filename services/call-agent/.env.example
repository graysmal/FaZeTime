# Copy to .env.local (mode 600) and fill in privately. Never commit, paste or log values.
# All three LiveKit values must come from the same LiveKit Cloud project. The same keys
# pay for the voice model through LiveKit Inference; no separate model key is needed.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Dispatch name; chert dev and chert doctor use the same value.
AGENT_NAME=fazetime-bookie
# Optional overrides (defaults: openai/gpt-realtime-2.1-mini, voice ash, pitch 0.92, puppet at 0.5).
REALTIME_MODEL=
REALTIME_VOICE=
VOICE_PITCH=
PUPPET_SCALE=
# FaZeTime API (Pi, over the tailnet) and this line's CALL_WORKER token (CONTRACTS 9.21).
# Mint the token on the API host: python -m fazetime_api issue-call-worker-token --label call-agent
FAZETIME_API_BASE=http://fazetime:8000
FAZETIME_CALL_WORKER_TOKEN=
